<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ContratacaoBolsista" targetNamespace="https://ifam.edu.br/polo-inovacao/processos/contratacao-bolsista">
  <bpmn:collaboration id="Collaboration_ContratacaoBolsista">
    <bpmn:participant id="Participant_IFAM" name="IFAM — Polo de Inovação" processRef="Process_IFAM" />
    <bpmn:participant id="Participant_FAEPI" name="FAEPI" processRef="Process_FAEPI" />
    <bpmn:messageFlow id="MessageFlow_Termo" name="Confirmação de termo formalizado" sourceRef="Task_ComunicarFormalizacao" targetRef="Participant_IFAM" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IFAM" name="Indicação e providências do Polo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_IFAM">
      <bpmn:lane id="Lane_Coordenador" name="Coordenador do Projeto">
        <bpmn:flowNodeRef>Task_EnviarFormulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarOficioFAEPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceberPendencias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvidenciarCorrecoes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReenviarDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElaborarOficio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceberLiberacaoOficio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssinarOficioCoord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AguardarRespostaFAEPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceberTermo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RH" name="Coordenação de RH do Polo">
        <bpmn:flowNodeRef>Task_ReceberFormulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitarDocumentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceberDocsRH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConferirDocsRH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocsRH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssinarOficioRH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitarAjustesRH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformarLiberacao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bolsista" name="Bolsista indicado">
        <bpmn:flowNodeRef>Task_ReceberPedidoDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarDocsBolsista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplementarDocsRH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Encaminhado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DiretorPolo" name="Diretor do Polo">
        <bpmn:flowNodeRef>Task_AssinarOficioDiretor</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sendTask id="Task_EnviarFormulario" name="Enviar formulário de indicação por e-mail rh.polo@ifam.edu.br" />
    <bpmn:receiveTask id="Task_ReceberFormulario" name="Receber formulário de indicação" />
    <bpmn:sendTask id="Task_SolicitarDocumentos" name="Solicitar documentos ao bolsista" />
    <bpmn:receiveTask id="Task_ReceberPedidoDocs" name="Receber solicitação de documentos" />
    <bpmn:sendTask id="Task_EnviarDocsBolsista" name="Encaminhar documentação ao RH do Polo" />
    <bpmn:receiveTask id="Task_ReceberDocsRH" name="Receber documentação do bolsista" />
    <bpmn:userTask id="Task_ConferirDocsRH" name="Conferir documentação inicial" />
    <bpmn:exclusiveGateway id="Gateway_DocsRH" name="Documentação correta e completa?" gatewayDirection="Diverging">
      <bpmn:outgoing>Flow_IFAM_09_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ComplementarDocsRH" name="Complementar ou corrigir documentação" />
    <bpmn:userTask id="Task_AssinarOficioDiretor" name="Assinar ofício — 3º: Diretor do Polo" />
    <bpmn:userTask id="Task_AssinarOficioRH" name="Assinar ofício — 2º: Coordenação de RH do Polo" />
    <bpmn:sendTask id="Task_EnviarOficioFAEPI" name="Encaminhar ofício assinado e documentação à FAEPI" />
    <bpmn:receiveTask id="Task_ReceberPendencias" name="Receber pendências diretamente da FAEPI" />
    <bpmn:userTask id="Task_ProvidenciarCorrecoes" name="Coordenar correções com os envolvidos" />
    <bpmn:sendTask id="Task_ReenviarDocs" name="Reencaminhar documentação corrigida à FAEPI" />
    <bpmn:sequenceFlow id="Flow_IFAM_01" sourceRef="StartEvent_Inicio" targetRef="Task_EnviarFormulario" />
    <bpmn:sequenceFlow id="Flow_IFAM_02" sourceRef="Task_EnviarFormulario" targetRef="Task_ReceberFormulario" />
    <bpmn:sequenceFlow id="Flow_IFAM_03" sourceRef="Task_ReceberFormulario" targetRef="Task_SolicitarDocumentos" />
    <bpmn:sequenceFlow id="Flow_IFAM_04" sourceRef="Task_SolicitarDocumentos" targetRef="Task_ReceberPedidoDocs" />
    <bpmn:sequenceFlow id="Flow_IFAM_05" sourceRef="Task_ReceberPedidoDocs" targetRef="Task_EnviarDocsBolsista" />
    <bpmn:sequenceFlow id="Flow_IFAM_06" sourceRef="Task_EnviarDocsBolsista" targetRef="Task_ReceberDocsRH" />
    <bpmn:sequenceFlow id="Flow_IFAM_07" sourceRef="Task_ReceberDocsRH" targetRef="Task_ConferirDocsRH" />
    <bpmn:sequenceFlow id="Flow_IFAM_08" sourceRef="Task_ConferirDocsRH" targetRef="Gateway_DocsRH" />
    <bpmn:sequenceFlow id="Flow_IFAM_10" sourceRef="Task_SolicitarAjustesRH" targetRef="Task_ComplementarDocsRH" />
    <bpmn:sequenceFlow id="Flow_IFAM_11" sourceRef="Task_ComplementarDocsRH" targetRef="Task_EnviarDocsBolsista" />
    <bpmn:sequenceFlow id="Flow_IFAM_12_Sim" name="Sim" sourceRef="Gateway_DocsRH" targetRef="Task_InformarLiberacao" />
    <bpmn:sequenceFlow id="Flow_IFAM_13" sourceRef="Task_InformarLiberacao" targetRef="Task_ReceberLiberacaoOficio" />
    <bpmn:sequenceFlow id="Flow_IFAM_14" sourceRef="Task_ReceberLiberacaoOficio" targetRef="Task_ElaborarOficio" />
    <bpmn:sequenceFlow id="Flow_IFAM_24" sourceRef="Task_ReceberPendencias" targetRef="Task_ProvidenciarCorrecoes" />
    <bpmn:sequenceFlow id="Flow_IFAM_25" sourceRef="Task_ProvidenciarCorrecoes" targetRef="Task_ReenviarDocs" />
    <bpmn:sequenceFlow id="Flow_IFAM_15" sourceRef="Task_ElaborarOficio" targetRef="Task_AssinarOficioCoord" />
    <bpmn:sequenceFlow id="Flow_IFAM_16" sourceRef="Task_AssinarOficioCoord" targetRef="Task_AssinarOficioRH" />
    <bpmn:sequenceFlow id="Flow_IFAM_17" sourceRef="Task_AssinarOficioRH" targetRef="Task_AssinarOficioDiretor" />
    <bpmn:sequenceFlow id="Flow_IFAM_18" sourceRef="Task_AssinarOficioDiretor" targetRef="Task_EnviarOficioFAEPI" />
    <bpmn:sequenceFlow id="Flow_IFAM_23" sourceRef="Task_EnviarOficioFAEPI" targetRef="Gateway_AguardarRespostaFAEPI" />
    <bpmn:sequenceFlow id="Flow_IFAM_23A" sourceRef="Gateway_AguardarRespostaFAEPI" targetRef="Task_ReceberPendencias" />
    <bpmn:sequenceFlow id="Flow_IFAM_25A" sourceRef="Task_ReenviarDocs" targetRef="Gateway_AguardarRespostaFAEPI" />
    <bpmn:sequenceFlow id="Flow_IFAM_26" sourceRef="Task_ReceberTermo" targetRef="EndEvent_Encaminhado" />
    <bpmn:startEvent id="StartEvent_Inicio" name="Indicação a formalizar" />
    <bpmn:sequenceFlow id="Flow_IFAM_09_Nao" name="Não" sourceRef="Gateway_DocsRH" targetRef="Task_SolicitarAjustesRH" />
    <bpmn:sendTask id="Task_SolicitarAjustesRH" name="Solicitar complementação ou correção ao bolsista">
      <bpmn:incoming>Flow_IFAM_09_Nao</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_InformarLiberacao" name="Informar que o ofício pode ser encaminhado">
      <bpmn:incoming>Flow_IFAM_12_Sim</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_ElaborarOficio" name="Elaborar ofício de solicitação de contratação" />
    <bpmn:receiveTask id="Task_ReceberLiberacaoOficio" name="Receber liberação para emitir o ofício" />
    <bpmn:userTask id="Task_AssinarOficioCoord" name="Assinar ofício — 1º: Coordenador do Projeto" />
    <bpmn:eventBasedGateway id="Gateway_AguardarRespostaFAEPI" name="Aguardar retorno da FAEPI" gatewayDirection="Diverging">
      <bpmn:outgoing>Flow_0b1pedx</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_0b1pedx" sourceRef="Gateway_AguardarRespostaFAEPI" targetRef="Task_ReceberTermo" />
    <bpmn:receiveTask id="Task_ReceberTermo" name="Receber confirmação de formalização do Termo">
      <bpmn:incoming>Flow_0b1pedx</bpmn:incoming>
      <bpmn:outgoing>Flow_IFAM_26</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_Encaminhado" name="Bolsista autorizado a iniciar após formalização">
      <bpmn:incoming>Flow_IFAM_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="TextAnnotation_EmailRH">
      <bpmn:text>Enviar para: [E-MAIL RH DO POLO A INFORMAR]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_EmailRH" sourceRef="Task_EnviarFormulario" targetRef="TextAnnotation_EmailRH" />
    <bpmn:textAnnotation id="TextAnnotation_Termo">
      <bpmn:text>As assinaturas do Termo de Concessão são coletadas em paralelo. São obrigatórias as assinaturas do bolsista e da Diretoria da FAEPI; a assinatura do Diretor do Polo é incluída somente quando exigida pela FAEPI. A formalização depende de todas as assinaturas aplicáveis.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Termo" targetRef="TextAnnotation_Termo" />
  </bpmn:process>
  <bpmn:process id="Process_FAEPI" name="Análise e formalização pela FAEPI" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FAEPI">
      <bpmn:lane id="Lane_AnalistaFAEPI" name="Analista da FAEPI">
        <bpmn:flowNodeRef>StartEvent_RecebeOficio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceberOficioFAEPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConferirDocsFAEPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocsFAEPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComunicarPendencias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceberDocsCorrigidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmitirTermo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EncaminharTermo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssinaturasTermoSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TermoEmitido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComunicarFormalizacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssinaturasTermoJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssinarTermoBolsistaFAEPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssinarTermoDiretorPolo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DiretoriaFAEPI" name="Diretoria da FAEPI">
        <bpmn:flowNodeRef>Task_AssinarTermoFAEPI</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_RecebeOficio" name="Ofício recebido" />
    <bpmn:receiveTask id="Task_ReceberOficioFAEPI" name="Receber ofício e documentação" />
    <bpmn:userTask id="Task_ConferirDocsFAEPI" name="Conferir documentação" />
    <bpmn:exclusiveGateway id="Gateway_DocsFAEPI" name="Documentação aprovada?" gatewayDirection="Diverging" />
    <bpmn:sendTask id="Task_ComunicarPendencias" name="Comunicar pendências diretamente ao Coordenador do Projeto" />
    <bpmn:receiveTask id="Task_ReceberDocsCorrigidos" name="Receber documentação corrigida" />
    <bpmn:userTask id="Task_EmitirTermo" name="Emitir Termo de Concessão de Bolsa" />
    <bpmn:sendTask id="Task_EncaminharTermo" name="Encaminhar termo para coleta de assinaturas" />
    <bpmn:sequenceFlow id="Flow_FAEPI_01" sourceRef="StartEvent_RecebeOficio" targetRef="Task_ReceberOficioFAEPI" />
    <bpmn:sequenceFlow id="Flow_FAEPI_02" sourceRef="Task_ReceberOficioFAEPI" targetRef="Task_ConferirDocsFAEPI" />
    <bpmn:sequenceFlow id="Flow_FAEPI_03" sourceRef="Task_ConferirDocsFAEPI" targetRef="Gateway_DocsFAEPI" />
    <bpmn:sequenceFlow id="Flow_FAEPI_04_Nao" name="Não" sourceRef="Gateway_DocsFAEPI" targetRef="Task_ComunicarPendencias" />
    <bpmn:sequenceFlow id="Flow_FAEPI_05" sourceRef="Task_ComunicarPendencias" targetRef="Task_ReceberDocsCorrigidos" />
    <bpmn:sequenceFlow id="Flow_FAEPI_06" sourceRef="Task_ReceberDocsCorrigidos" targetRef="Task_ConferirDocsFAEPI" />
    <bpmn:sequenceFlow id="Flow_FAEPI_07_Sim" name="Sim" sourceRef="Gateway_DocsFAEPI" targetRef="Task_EmitirTermo" />
    <bpmn:sequenceFlow id="Flow_FAEPI_08" sourceRef="Task_EmitirTermo" targetRef="Task_EncaminharTermo" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09" sourceRef="Task_EncaminharTermo" targetRef="Gateway_AssinaturasTermoSplit" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09A" sourceRef="Gateway_AssinaturasTermoSplit" targetRef="Task_AssinarTermoBolsistaFAEPI" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09B" sourceRef="Gateway_AssinaturasTermoSplit" targetRef="Task_AssinarTermoFAEPI" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09C" sourceRef="Gateway_AssinaturasTermoSplit" targetRef="Task_AssinarTermoDiretorPolo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">diretorPoloExigido = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FAEPI_09D" sourceRef="Task_AssinarTermoBolsistaFAEPI" targetRef="Gateway_AssinaturasTermoJoin" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09E" sourceRef="Task_AssinarTermoFAEPI" targetRef="Gateway_AssinaturasTermoJoin" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09F" sourceRef="Task_AssinarTermoDiretorPolo" targetRef="Gateway_AssinaturasTermoJoin" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09G" sourceRef="Gateway_AssinaturasTermoJoin" targetRef="Task_ComunicarFormalizacao" />
    <bpmn:sequenceFlow id="Flow_FAEPI_09H" sourceRef="Task_ComunicarFormalizacao" targetRef="EndEvent_TermoEmitido" />
    <bpmn:inclusiveGateway id="Gateway_AssinaturasTermoSplit" name="Selecionar signatários aplicáveis" gatewayDirection="Diverging" />
    <bpmn:endEvent id="EndEvent_TermoEmitido" name="Termo emitido e encaminhado para assinaturas" />
    <bpmn:sendTask id="Task_ComunicarFormalizacao" name="Comunicar formalização da contratação ao Polo" />
    <bpmn:inclusiveGateway id="Gateway_AssinaturasTermoJoin" name="Todas as assinaturas aplicáveis obtidas" gatewayDirection="Converging" />
    <bpmn:userTask id="Task_AssinarTermoBolsistaFAEPI" name="Obter assinatura do bolsista" />
    <bpmn:userTask id="Task_AssinarTermoDiretorPolo" name="Obter assinatura do Diretor do Polo (quando exigida)" />
    <bpmn:userTask id="Task_AssinarTermoFAEPI" name="Assinar Termo de Concessão — Diretoria da FAEPI" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Contratacao">
    <bpmndi:BPMNPlane id="BPMNPlane_Contratacao" bpmnElement="Collaboration_ContratacaoBolsista">
      <bpmndi:BPMNShape id="Shape_Participant_IFAM" bpmnElement="Participant_IFAM" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="3820" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DiretorPolo" bpmnElement="Lane_DiretorPolo" isHorizontal="true">
        <dc:Bounds x="130" y="580" width="3790" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Bolsista" bpmnElement="Lane_Bolsista" isHorizontal="true">
        <dc:Bounds x="130" y="430" width="3790" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_RH" bpmnElement="Lane_RH" isHorizontal="true">
        <dc:Bounds x="130" y="260" width="3790" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Coordenador" bpmnElement="Lane_Coordenador" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="3790" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_Inicio" bpmnElement="StartEvent_Inicio">
        <dc:Bounds x="180" y="150" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="170" y="196" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EnviarFormulario" bpmnElement="Task_EnviarFormulario">
        <dc:Bounds x="250" y="130" width="130" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceberFormulario" bpmnElement="Task_ReceberFormulario">
        <dc:Bounds x="430" y="300" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SolicitarDocumentos" bpmnElement="Task_SolicitarDocumentos">
        <dc:Bounds x="600" y="300" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceberPedidoDocs" bpmnElement="Task_ReceberPedidoDocs">
        <dc:Bounds x="780" y="465" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EnviarDocsBolsista" bpmnElement="Task_EnviarDocsBolsista">
        <dc:Bounds x="950" y="465" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceberDocsRH" bpmnElement="Task_ReceberDocsRH">
        <dc:Bounds x="1120" y="300" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ConferirDocsRH" bpmnElement="Task_ConferirDocsRH">
        <dc:Bounds x="1290" y="300" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_DocsRH" bpmnElement="Gateway_DocsRH" isMarkerVisible="true">
        <dc:Bounds x="1470" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ComplementarDocsRH" bpmnElement="Task_ComplementarDocsRH">
        <dc:Bounds x="1750" y="465" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssinarOficioDiretor" bpmnElement="Task_AssinarOficioDiretor">
        <dc:Bounds x="2540" y="615" width="110" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssinarOficioRH" bpmnElement="Task_AssinarOficioRH">
        <dc:Bounds x="2360" y="315" width="110" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EnviarOficioFAEPI" bpmnElement="Task_EnviarOficioFAEPI">
        <dc:Bounds x="2720" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceberPendencias" bpmnElement="Task_ReceberPendencias">
        <dc:Bounds x="2900" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ProvidenciarCorrecoes" bpmnElement="Task_ProvidenciarCorrecoes">
        <dc:Bounds x="3070" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReenviarDocs" bpmnElement="Task_ReenviarDocs">
        <dc:Bounds x="3240" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SolicitarAjustesRH" bpmnElement="Task_SolicitarAjustesRH">
        <dc:Bounds x="1580" y="330" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_InformarLiberacao" bpmnElement="Task_InformarLiberacao">
        <dc:Bounds x="1765" y="265" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ElaborarOficio" bpmnElement="Task_ElaborarOficio">
        <dc:Bounds x="1985" y="113" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceberLiberacaoOficio" bpmnElement="Task_ReceberLiberacaoOficio">
        <dc:Bounds x="1785" y="113" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssinarOficioCoord" bpmnElement="Task_AssinarOficioCoord">
        <dc:Bounds x="2180" y="120" width="110" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_AguardarRespostaFAEPI" bpmnElement="Gateway_AguardarRespostaFAEPI" isMarkerVisible="true">
